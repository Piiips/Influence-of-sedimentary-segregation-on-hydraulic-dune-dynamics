      <rdf:Description rdf:about="" xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Hydrology: River channels; Hydrology: Erosion; Hydrology: Sedimentation; Hydrology: Sediment transport; Mathematical Geophysics: Stochastic processes</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Vertical sorting and the morphodynamics of bed form&amp;hyphen;dominated rivers: A sorting evolution model</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Astrid Blom, Jan S. Ribberink, Gary Parker</rdf:li>
            </rdf:Seq>
         </dc:creator>
      </rdf:Description>
